opam-version: "2.0"
name: "astral"
version: "0.1"
synopsis: "Solver for separation logic(s) based on translation to SMT"
maintainer: "Tomáš Dacík <idacik@fit.vut.cz>"
authors: [
    "Tomáš Dacík <idacik@fit.vut.cz>"
    "Adam Rogalewicz <rogalew@fit.vut.cz>"
    "Tomáš Vojnar <vojnar@fit.vut.cz>"
    "Florian Zuleger<florian.zuleger@tuwien.ac.at>"
]
license: "MIT"
homepage: "https://github.com/TDacik/Astral"
dev-repo: "git://github.com/TDacik/Astral.git"
bug-reports: "https://github.com/TDacik/Astral/issues"

depends: [
  "ocaml" {>= "5.1.0"}
  "dune"
  "batteries"
  "bitwuzla"
  "z3"
  "dolmen" {= "0.10"}
  "ocamlgraph"
  "sexplib"
  "yojson"
  "ppx_compare"
  "ppx_deriving"

  "alcotest" {with-test}
  "qcheck" {with-test}

  "odoc" {with-doc}
]

build: [
    ["dune" "build"]
]

install: [
    ["dune" "install"]
]
