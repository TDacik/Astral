(data_only_dirs
  unused
  scripts
)

; Rule for generating benchmarks
(rule
  (alias benchmarks)
  (targets (dir _benchmarks))
  (deps (source_tree benchmarks))
  (action
    (run python3 %{dep:scripts/benchmarks/build.py}
         --source benchmarks --target _benchmarks))
)


(env
    (dev
        (flags (:standard -w -8    ; Partial pattern-matching
                          -w -32   ; Unused value declaration
                          -w -26   ; Unused var
                          -w -27   ; Unused var strict
                          -w -48   ; implicit elimination of optional argument
                          -w -67   ; Unused functor parameter
                          -g
                )
        )
    )
)
