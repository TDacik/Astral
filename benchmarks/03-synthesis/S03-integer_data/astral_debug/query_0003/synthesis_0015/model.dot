digraph G {
  "0" [shape=box, label="0 : y,nil", ];
  "1" [shape=box, label="1 : x", ];
  "2" [shape=box, label="2 : ", ];
  "data_#b01111111" [shape=circle, label="#b01111111", ];
  "data_#b11111111" [shape=circle, label="#b11111111", ];
  "nil_-1" [shape=plaintext, label="_|_", ];
  
  
  "1" -> "2" [label="next", ];
  "1" -> "data_#b11111111" [label="data", ];
  "2" -> "data_#b01111111" [label="data", ];
  "2" -> "nil_-1" [label="next", ];
  
  }
