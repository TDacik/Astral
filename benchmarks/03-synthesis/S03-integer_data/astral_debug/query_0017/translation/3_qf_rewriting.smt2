(set-info :status unknown)

(declare-const field_data (Array (_ BitVec 4) (_ BitVec 8)))
(declare-const footprint2 (_ BitVec 4))
(declare-const footprint3 (_ BitVec 4))
(declare-const footprint4 (_ BitVec 4))
(declare-const footprint5 (_ BitVec 4))
(declare-const footprint6 (_ BitVec 4))
(declare-const footprint7 (_ BitVec 4))
(declare-const footprint8 (_ BitVec 4))
(declare-const footprint9 (_ BitVec 4))
(declare-const footprint10 (_ BitVec 4))
(declare-const footprint0 (_ BitVec 4))
(declare-const nil (_ BitVec 4))
(declare-const y (_ BitVec 4))
(declare-const x (_ BitVec 4))
(declare-const Ref_LS (_ BitVec 4))
(declare-const field_next (Array (_ BitVec 4) (_ BitVec 4)))

(assert
 (and (distinct x (select field_next x)) (= footprint2 #b0000) (distinct x y)
  (= footprint3 #b0000)
  (distinct (select field_data x) (select field_data (select field_next x)))
  (= footprint4 #b0000) (distinct (select field_next x) y)
  (= footprint5 #b0000) (distinct x (select field_next x))
  (= footprint6 #b0000) (distinct x y) (= footprint7 #b0000)
  (distinct (select field_next x) y) (= footprint8 #b0000)
  (= footprint9 (>> #b0001 x))
  (= footprint10 (>> #b0001 (select field_next x)))
  (= (select field_next (select field_next x)) y)
  (and (= (bit-and footprint9 footprint10) #b0000)
   (= (bit-and footprint8 footprint10) #b0000)
   (= (bit-and footprint8 footprint9) #b0000)
   (= (bit-and footprint7 footprint10) #b0000)
   (= (bit-and footprint7 footprint9) #b0000)
   (= (bit-and footprint7 footprint8) #b0000)
   (= (bit-and footprint6 footprint10) #b0000)
   (= (bit-and footprint6 footprint9) #b0000)
   (= (bit-and footprint6 footprint8) #b0000)
   (= (bit-and footprint6 footprint7) #b0000)
   (= (bit-and footprint5 footprint10) #b0000)
   (= (bit-and footprint5 footprint9) #b0000)
   (= (bit-and footprint5 footprint8) #b0000)
   (= (bit-and footprint5 footprint7) #b0000)
   (= (bit-and footprint5 footprint6) #b0000)
   (= (bit-and footprint4 footprint10) #b0000)
   (= (bit-and footprint4 footprint9) #b0000)
   (= (bit-and footprint4 footprint8) #b0000)
   (= (bit-and footprint4 footprint7) #b0000)
   (= (bit-and footprint4 footprint6) #b0000)
   (= (bit-and footprint4 footprint5) #b0000)
   (= (bit-and footprint3 footprint10) #b0000)
   (= (bit-and footprint3 footprint9) #b0000)
   (= (bit-and footprint3 footprint8) #b0000)
   (= (bit-and footprint3 footprint7) #b0000)
   (= (bit-and footprint3 footprint6) #b0000)
   (= (bit-and footprint3 footprint5) #b0000)
   (= (bit-and footprint3 footprint4) #b0000)
   (= (bit-and footprint2 footprint10) #b0000)
   (= (bit-and footprint2 footprint9) #b0000)
   (= (bit-and footprint2 footprint8) #b0000)
   (= (bit-and footprint2 footprint7) #b0000)
   (= (bit-and footprint2 footprint6) #b0000)
   (= (bit-and footprint2 footprint5) #b0000)
   (= (bit-and footprint2 footprint4) #b0000)
   (= (bit-and footprint2 footprint3) #b0000))
  (= footprint0
   (bit-or footprint2 footprint3 footprint4 footprint5 footprint6 footprint7
    footprint8 footprint9 footprint10))
  (not
   (and (= (bit-and (>> #b0001 x) (>> #b0001 (select field_next x))) #b0000)
    (= footprint0 (bit-or (>> #b0001 x) (>> #b0001 (select field_next x))))
    (= (>> #b0001 x) (>> #b0001 x)) true
    (= (>> #b0001 (select field_next x)) (>> #b0001 (select field_next x)))
    (= (>> #b0001 (select field_next x)) (>> #b0001 (select field_next x)))
    (= #b0000 #b0000)))
  (not (bit-check footprint0 (as nil Bool))) (= #b0000 (as nil Bitvector4))
  (bit-check Ref_LS y) (bit-check Ref_LS x)
  (bit-check Ref_LS (select field_next x))
  (bit-check Ref_LS (select field_next (select field_next x)))
  (= Ref_LS
   (bit-or (>> #b0001 #b0000) (>> #b0001 #b0001) (>> #b0001 #b0010)
    (>> #b0001 #b0011)))
  (= #b0000 (select field_next #b0000))))