(set-info :status unknown)

(declare-const d1 (_ BitVec 8))
(declare-const d2 (_ BitVec 8))
(declare-const field_data (Array (_ BitVec 5) (_ BitVec 8)))
(declare-const d3 (_ BitVec 8))
(declare-const footprint4 (Set (_ BitVec 5)))
(declare-const footprint5 (Set (_ BitVec 5)))
(declare-const footprint6 (Set (_ BitVec 5)))
(declare-const footprint7 (Set (_ BitVec 5)))
(declare-const footprint2 (Set (_ BitVec 5)))
(declare-const footprint3 (Set (_ BitVec 5)))
(declare-const footprint0 (Set (_ BitVec 5)))
(declare-const nil (_ BitVec 5))
(declare-const x (_ BitVec 5))
(declare-const y (_ BitVec 5))
(declare-const n1 (_ BitVec 5))
(declare-const n2 (_ BitVec 5))
(declare-const Ref_LS (Set (_ BitVec 5)))
(declare-const field_next (Array (_ BitVec 5) (_ BitVec 5)))

(assert
 (and (distinct x n1 n2 y) (= footprint4 set) (= footprint5 (set x))
  (= (select field_next x) n1) (= (select field_data x) d1)
  (= footprint6 (set n1)) (= (select field_next n1) n2)
  (= (select field_data n1) d2) (= footprint7 (set n2))
  (= (select field_next n2) y) (= (select field_data n2) d3)
  (disjoint footprint4 footprint5 footprint6 footprint7)
  (= footprint2 (union footprint4 footprint5 footprint6 footprint7))
  (distinct n1 n2) (= footprint3 set) (disjoint footprint2 footprint3)
  (= footprint0 (union footprint2 footprint3))
  (not (mem (as nil Bool) footprint0)) (= #b00000 (as nil Bitvector5))
  (mem x Ref_LS) (mem y Ref_LS) (mem n1 Ref_LS) (mem n2 Ref_LS)
  (= Ref_LS (set #b00000 #b00001 #b00010 #b00011 #b00100))
  (= #b00000 (select field_next #b00000))))