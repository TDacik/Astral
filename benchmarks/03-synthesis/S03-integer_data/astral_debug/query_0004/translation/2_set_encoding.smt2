(set-info :status unknown)

(declare-const d1 (_ BitVec 8))
(declare-const d2 (_ BitVec 8))
(declare-const field_data (Array (_ BitVec 5) (_ BitVec 8)))
(declare-const d3 (_ BitVec 8))
(declare-const footprint4 (_ BitVec 5))
(declare-const footprint5 (_ BitVec 5))
(declare-const footprint6 (_ BitVec 5))
(declare-const footprint7 (_ BitVec 5))
(declare-const footprint2 (_ BitVec 5))
(declare-const footprint3 (_ BitVec 5))
(declare-const footprint0 (_ BitVec 5))
(declare-const nil (_ BitVec 5))
(declare-const x (_ BitVec 5))
(declare-const y (_ BitVec 5))
(declare-const n1 (_ BitVec 5))
(declare-const n2 (_ BitVec 5))
(declare-const Ref_LS (_ BitVec 5))
(declare-const field_next (Array (_ BitVec 5) (_ BitVec 5)))

(assert
 (and (distinct x n1 n2 y) (= footprint4 #b00000)
  (= footprint5 (>> #b00001 x)) (= (select field_next x) n1)
  (= (select field_data x) d1) (= footprint6 (>> #b00001 n1))
  (= (select field_next n1) n2) (= (select field_data n1) d2)
  (= footprint7 (>> #b00001 n2)) (= (select field_next n2) y)
  (= (select field_data n2) d3)
  (and (= (bit-and footprint6 footprint7) #b00000)
   (= (bit-and footprint5 footprint7) #b00000)
   (= (bit-and footprint5 footprint6) #b00000)
   (= (bit-and footprint4 footprint7) #b00000)
   (= (bit-and footprint4 footprint6) #b00000)
   (= (bit-and footprint4 footprint5) #b00000))
  (= footprint2 (bit-or footprint4 footprint5 footprint6 footprint7))
  (distinct n1 n2) (= footprint3 #b00000)
  (= (bit-and footprint2 footprint3) #b00000)
  (= footprint0 (bit-or footprint2 footprint3))
  (not (bit-check footprint0 (as nil Bool))) (= #b00000 (as nil Bitvector5))
  (bit-check Ref_LS x) (bit-check Ref_LS y) (bit-check Ref_LS n1)
  (bit-check Ref_LS n2)
  (= Ref_LS
   (bit-or (>> #b00001 #b00000) (>> #b00001 #b00001) (>> #b00001 #b00010)
    (>> #b00001 #b00011) (>> #b00001 #b00100)))
  (= #b00000 (select field_next #b00000))))