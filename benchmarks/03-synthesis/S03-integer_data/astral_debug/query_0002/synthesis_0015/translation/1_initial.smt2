(set-info :status unknown)

(declare-const field_data (Array (_ BitVec 5) (_ BitVec 8)))
(declare-const footprint2 (Set (_ BitVec 5)))
(declare-const footprint3 (Set (_ BitVec 5)))
(declare-const footprint4 (Set (_ BitVec 5)))
(declare-const footprint5 (Set (_ BitVec 5)))
(declare-const footprint6 (Set (_ BitVec 5)))
(declare-const footprint7 (Set (_ BitVec 5)))
(declare-const footprint8 (Set (_ BitVec 5)))
(declare-const footprint9 (Set (_ BitVec 5)))
(declare-const footprint10 (Set (_ BitVec 5)))
(declare-const footprint11 (Set (_ BitVec 5)))
(declare-const footprint12 (Set (_ BitVec 5)))
(declare-const footprint13 (Set (_ BitVec 5)))
(declare-const footprint14 (Set (_ BitVec 5)))
(declare-const footprint15 (Set (_ BitVec 5)))
(declare-const footprint16 (Set (_ BitVec 5)))
(declare-const footprint17 (Set (_ BitVec 5)))
(declare-const footprint18 (Set (_ BitVec 5)))
(declare-const footprint19 (Set (_ BitVec 5)))
(declare-const footprint0 (Set (_ BitVec 5)))
(declare-const nil (_ BitVec 5))
(declare-const x (_ BitVec 5))
(declare-const y (_ BitVec 5))
(declare-const Ref_LS (Set (_ BitVec 5)))
(declare-const field_next (Array (_ BitVec 5) (_ BitVec 5)))

(assert
 (and (distinct x (select field_next x)) (= footprint2 set)
  (distinct x (select field_next (select field_next x))) (= footprint3 set)
  (distinct x y) (= footprint4 set)
  (distinct (select field_data x) (select field_data (select field_next x)))
  (= footprint5 set)
  (distinct (select field_data x)
   (select field_data (select field_next (select field_next x))))
  (= footprint6 set)
  (distinct (select field_next x) (select field_next (select field_next x)))
  (= footprint7 set) (distinct (select field_next x) y) (= footprint8 set)
  (distinct (select field_data (select field_next x))
   (select field_data (select field_next (select field_next x))))
  (= footprint9 set) (distinct (select field_next (select field_next x)) y)
  (= footprint10 set) (distinct x (select field_next x)) (= footprint11 set)
  (distinct x (select field_next (select field_next x))) (= footprint12 set)
  (distinct x y) (= footprint13 set)
  (distinct (select field_next x) (select field_next (select field_next x)))
  (= footprint14 set) (distinct (select field_next x) y) (= footprint15 set)
  (distinct (select field_next (select field_next x)) y) (= footprint16 set)
  (= footprint17 (set x)) (= footprint18 (set (select field_next x)))
  (= footprint19 (set (select field_next (select field_next x))))
  (= (select field_next (select field_next (select field_next x))) y)
  (disjoint footprint2 footprint3 footprint4 footprint5 footprint6 footprint7
   footprint8 footprint9 footprint10 footprint11 footprint12 footprint13
   footprint14 footprint15 footprint16 footprint17 footprint18 footprint19)
  (= footprint0
   (union footprint2 footprint3 footprint4 footprint5 footprint6 footprint7
    footprint8 footprint9 footprint10 footprint11 footprint12 footprint13
    footprint14 footprint15 footprint16 footprint17 footprint18 footprint19))
  (not (mem (as nil Bool) footprint0)) (= #b00000 (as nil Bitvector5))
  (mem x Ref_LS) (mem (select field_next x) Ref_LS)
  (mem (select field_next (select field_next x)) Ref_LS) (mem y Ref_LS)
  (= Ref_LS (set #b00000 #b00001 #b00010 #b00011 #b00100))
  (= #b00000 (select field_next #b00000))))