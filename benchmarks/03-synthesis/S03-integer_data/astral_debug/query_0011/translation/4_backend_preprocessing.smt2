(set-info :status unknown)

(declare-const field_data (Array (_ BitVec 4) (_ BitVec 8)))
(declare-const footprint4 (_ BitVec 4))
(declare-const footprint5 (_ BitVec 4))
(declare-const footprint6 (_ BitVec 4))
(declare-const d1 (_ BitVec 8))
(declare-const d2 (_ BitVec 8))
(declare-const footprint2 (_ BitVec 4))
(declare-const footprint3 (_ BitVec 4))
(declare-const footprint0 (_ BitVec 4))
(declare-const nil (_ BitVec 4))
(declare-const x (_ BitVec 4))
(declare-const n1 (_ BitVec 4))
(declare-const y (_ BitVec 4))
(declare-const Ref_LS (_ BitVec 4))
(declare-const field_next (Array (_ BitVec 4) (_ BitVec 4)))

(assert
 (and (distinct x n1 y) (= footprint4 #b0000) (= footprint5 (>> #b0001 x))
  (= (select field_next x) n1) (= (select field_data x) d1)
  (= footprint6 (>> #b0001 n1)) (= (select field_next n1) y)
  (= (select field_data n1) d2)
  (and (= (bit-and footprint5 footprint6) #b0000)
   (= (bit-and footprint4 footprint6) #b0000)
   (= (bit-and footprint4 footprint5) #b0000))
  (= footprint2 (bit-or footprint4 footprint5 footprint6)) (distinct d1 d2)
  (= footprint3 #b0000) (= (bit-and footprint2 footprint3) #b0000)
  (= footprint0 (bit-or footprint2 footprint3))
  (not (bit-check footprint0 (as nil Bool))) (= #b0000 (as nil Bitvector4))
  (bit-check Ref_LS x) (bit-check Ref_LS n1) (bit-check Ref_LS y)
  (= Ref_LS
   (bit-or (>> #b0001 #b0000) (>> #b0001 #b0001) (>> #b0001 #b0010)
    (>> #b0001 #b0011)))
  (= #b0000 (select field_next #b0000))))