digraph G {
  "0" [shape=box, label="0 : nil", ];
  "1" [shape=box, label="1 : z", ];
  "2" [shape=box, label="2 : ", ];
  "3" [shape=box, label="3 : ", ];
  "4" [shape=box, label="4 : y", ];
  "5" [shape=box, label="5 : x", ];
  "6" [shape=box, label="6 : ", ];
  
  
  "2" -> "1" [label="next", ];
  "3" -> "1" [label="next", ];
  "5" -> "3" [label="down", ];
  "5" -> "6" [label="top", ];
  "6" -> "2" [label="down", ];
  "6" -> "4" [label="top", ];
  
  }
