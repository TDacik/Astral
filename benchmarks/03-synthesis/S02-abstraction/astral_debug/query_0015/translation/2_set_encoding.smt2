(set-info :status unknown)

(declare-const footprint2 (_ BitVec 3))
(declare-const footprint3 (_ BitVec 3))
(declare-const footprint4 (_ BitVec 3))
(declare-const footprint0 (_ BitVec 3))
(declare-const nil (_ BitVec 3))
(declare-const |e!15| (_ BitVec 3))
(declare-const x (_ BitVec 3))
(declare-const y (_ BitVec 3))
(declare-const z (_ BitVec 3))
(declare-const Ref_LS (_ BitVec 3))
(declare-const field_next (Array (_ BitVec 3) (_ BitVec 3)))

(assert
 (and (= footprint2 (>> #b001 z)) (= (select field_next z) |e!15|) (= x y)
  (= footprint3 #b000) (= y z) (= footprint4 #b000)
  (and (= (bit-and footprint3 footprint4) #b000)
   (= (bit-and footprint2 footprint4) #b000)
   (= (bit-and footprint2 footprint3) #b000))
  (= footprint0 (bit-or footprint2 footprint3 footprint4))
  (not (bit-check footprint0 (as nil Bool))) (= #b000 (as nil Bitvector3))
  (bit-check Ref_LS |e!15|) (bit-check Ref_LS x) (bit-check Ref_LS y)
  (bit-check Ref_LS z)
  (= Ref_LS (bit-or (>> #b001 #b000) (>> #b001 #b001) (>> #b001 #b010)))
  (= #b000 (select field_next #b000))))