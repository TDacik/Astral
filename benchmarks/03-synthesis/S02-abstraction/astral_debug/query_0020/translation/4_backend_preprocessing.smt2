  (distinct y (select field_next y)) (= footprint11 #b000000) (distinct y z)
  (= footprint12 #b000000) (distinct (select field_next y) z)
  (= footprint13 #b000000) (= footprint14 (>> #b000001 x))
  (= footprint15 (>> #b000001 (select field_next x)))
  (= (select field_next (select field_next x)) y)
  (and (= (bit-and footprint14 footprint15) #b000000)
   (= (bit-and footprint13 footprint15) #b000000)
