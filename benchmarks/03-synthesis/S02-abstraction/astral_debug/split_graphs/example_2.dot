digraph G {
  "(next[.] x)" [style="solid", ];
  "(next[.] y)" [style="solid", ];
  "x" [style="dashed", ];
  "y" [style="dashed", ];
  "z" [style="dashed", ];
  
  
  "(next[.] x)" -> "y" [style="dashed", ];
  "(next[.] y)" -> "z" [style="dashed", ];
  "x" -> "(next[.] x)" [style="solid", ];
  "y" -> "(next[.] y)" [style="solid", ];
  
  }
