(set-info :status unknown)

(declare-const footprint4 (_ BitVec 9))
(declare-const footprint5 (_ BitVec 9))
(declare-const footprint6 (_ BitVec 9))
(declare-const footprint7 (_ BitVec 9))
(declare-const footprint8 (_ BitVec 9))
(declare-const footprint9 (_ BitVec 9))
(declare-const footprint10 (_ BitVec 9))
(declare-const footprint11 (_ BitVec 9))
(declare-const footprint2 (_ BitVec 9))
(declare-const footprint3 (_ BitVec 9))
(declare-const footprint0 (_ BitVec 9))
(declare-const nil (_ BitVec 9))
(declare-const |e!7| (_ BitVec 9))
(declare-const x (_ BitVec 9))
(declare-const n1 (_ BitVec 9))
(declare-const n2 (_ BitVec 9))
(declare-const y (_ BitVec 9))
(declare-const n3 (_ BitVec 9))
(declare-const n4 (_ BitVec 9))
(declare-const z (_ BitVec 9))
(declare-const Ref_LS (_ BitVec 9))
(declare-const field_next (Array (_ BitVec 9) (_ BitVec 9)))

(assert
 (and (= footprint2 (>> #b000000001 z)) (= (select field_next z) |e!7|)
  (distinct x n1 n2 y) (= footprint4 #b000000000)
  (= footprint5 (>> #b000000001 x)) (= (select field_next x) n1)
  (= footprint6 (>> #b000000001 n1)) (= (select field_next n1) n2)
  (= footprint7 (>> #b000000001 n2)) (= (select field_next n2) y)
  (distinct y n3 n4 z) (= footprint8 #b000000000)
  (= footprint9 (>> #b000000001 y)) (= (select field_next y) n3)
  (= footprint10 (>> #b000000001 n3)) (= (select field_next n3) n4)
  (= footprint11 (>> #b000000001 n4)) (= (select field_next n4) z)
  (and (= (bit-and footprint10 footprint11) #b000000000)
   (= (bit-and footprint9 footprint11) #b000000000)
   (= (bit-and footprint9 footprint10) #b000000000)
   (= (bit-and footprint8 footprint11) #b000000000)
   (= (bit-and footprint8 footprint10) #b000000000)
   (= (bit-and footprint8 footprint9) #b000000000)
   (= (bit-and footprint7 footprint11) #b000000000)
   (= (bit-and footprint7 footprint10) #b000000000)
   (= (bit-and footprint7 footprint9) #b000000000)
   (= (bit-and footprint7 footprint8) #b000000000)
   (= (bit-and footprint6 footprint11) #b000000000)
   (= (bit-and footprint6 footprint10) #b000000000)
   (= (bit-and footprint6 footprint9) #b000000000)
   (= (bit-and footprint6 footprint8) #b000000000)
   (= (bit-and footprint6 footprint7) #b000000000)
   (= (bit-and footprint5 footprint11) #b000000000)
   (= (bit-and footprint5 footprint10) #b000000000)
   (= (bit-and footprint5 footprint9) #b000000000)
   (= (bit-and footprint5 footprint8) #b000000000)
   (= (bit-and footprint5 footprint7) #b000000000)
   (= (bit-and footprint5 footprint6) #b000000000)
   (= (bit-and footprint4 footprint11) #b000000000)
   (= (bit-and footprint4 footprint10) #b000000000)
   (= (bit-and footprint4 footprint9) #b000000000)
   (= (bit-and footprint4 footprint8) #b000000000)
   (= (bit-and footprint4 footprint7) #b000000000)
   (= (bit-and footprint4 footprint6) #b000000000)
   (= (bit-and footprint4 footprint5) #b000000000))
  (= footprint3
   (bit-or footprint4 footprint5 footprint6 footprint7 footprint8 footprint9
    footprint10 footprint11))
  (= (bit-and footprint2 footprint3) #b000000000)
  (= footprint0 (bit-or footprint2 footprint3))
  (not (bit-check footprint0 (as nil Bool)))
  (= #b000000000 (as nil Bitvector9)) (bit-check Ref_LS |e!7|)
  (bit-check Ref_LS x) (bit-check Ref_LS n1) (bit-check Ref_LS n2)
  (bit-check Ref_LS y) (bit-check Ref_LS n3) (bit-check Ref_LS n4)
  (bit-check Ref_LS z)
  (= Ref_LS
   (bit-or (>> #b000000001 #b000000000) (>> #b000000001 #b000000001)
    (>> #b000000001 #b000000010) (>> #b000000001 #b000000011)
    (>> #b000000001 #b000000100) (>> #b000000001 #b000000101)
    (>> #b000000001 #b000000110) (>> #b000000001 #b000000111)
    (>> #b000000001 #b000001000)))
  (= #b000000000 (select field_next #b000000000))))